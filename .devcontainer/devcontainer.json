{
    "name": "Isaac ROS and ZED Development Environment",
    "dockerComposeFile": "docker-compose.yaml",
    // "service": "isaac-ros",
    "service": "zed",
    "workspaceFolder": "/home/${localEnv:USER}/slam_benchmark",
    
    // Remote user dynamically maps to the host user via workspace-entrypoint
    "remoteUser": "${localEnv:USER}",
    "customizations": {
        "vscode": {
            "extensions": [
                "mhutchie.git-graph",
                "ms-python.vscode-python-envs",
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "redhat.vscode-yaml",
                "tamasfe.even-better-toml"
            ]
        }
    }
}